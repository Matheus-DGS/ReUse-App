# Conexão com o PostgreSQL (local, Neon, Supabase...)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/reuse?schema=public"
# Conexão direta usada pelas migrations (em banco local, repita a mesma URL)
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@localhost:5432/reuse?schema=public"

# Chave usada para assinar o cookie de sessão (gere uma string longa e aleatória)
JWT_SECRET="troque-esta-chave-por-uma-string-aleatoria-e-secreta"
